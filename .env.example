# Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Your own Discord user ID (Discord Settings -> Advanced -> enable Developer Mode,
# then right-click your name -> Copy User ID). ONLY this user's messages are ever
# processed - this is the entire security boundary for the bot, keep it correct.
DISCORD_ALLOWED_USER_ID=

# 伺服器（guild）ID。bot 會在這個伺服器中為每台裝置自動建立/使用專屬頻道
# `claude-<DEVICE_NAME>`（bot 需要 Manage Channels 權限）。
# 若留空，則由 DISCORD_CHANNEL_ID 所屬的伺服器推得。
DISCORD_GUILD_ID=

# 備援頻道 ID：無法建立專屬頻道（例如缺少權限）時改用這個。
# 注意：多台裝置共用同一個備援頻道時，每台都會回應訊息。
DISCORD_CHANNEL_ID=

# 這台電腦的名稱（每台各設一個唯一名稱，預設為主機名稱）。
# 決定專屬頻道名稱 `claude-<名稱>`，也會標示在每則訊息上。
DEVICE_NAME=

# Comma-separated notification_type values to NOT forward to Discord.
# Default suppresses idle_prompt (fires every time Claude goes idle - noisy).
# Other known types: permission_prompt, quota_auto_resume_fired,
# quota_auto_resume_stale, quota_auto_resume_disabled, elicitation_dialog,
# elicitation_url_dialog, agent_needs_input, agent_completed
NOTIFY_SKIP_TYPES=idle_prompt

# 從 Discord 觸發的 claude 以 dontAsk 模式執行：只有這裡列出的工具能自動執行，其餘一律拒絕。
# 逗號分隔；預設允許改檔與本機 git（status/diff/log/add/commit，不含 push）。
# 設為 none 則全部拒絕（唯讀）。放寬等於讓你的 Discord 帳號能在這台電腦做更多事，請謹慎。
# CLAUDE_ALLOWED_TOOLS=Edit,Write,Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git add:*),Bash(git commit:*)

# 離開模式（Discord 的 !away on）下，等待你在 Discord 回答選項的秒數，逾時就回到電腦上的對話框。
# ~/.claude/settings.json 中 AskUserQuestion 那個 hook 的 timeout 必須大於這個值。
# ASK_WAIT_SECONDS=300
