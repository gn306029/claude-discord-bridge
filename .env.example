# Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Your own Discord user ID (Discord Settings -> Advanced -> enable Developer Mode,
# then right-click your name -> Copy User ID). ONLY this user's messages are ever
# processed - this is the entire security boundary for the bot, keep it correct.
DISCORD_ALLOWED_USER_ID=

# Channel ID the bot posts notifications to and accepts commands in.
# Right-click the channel -> Copy Channel ID. If left empty, the bot only
# works via DM with DISCORD_ALLOWED_USER_ID.
DISCORD_CHANNEL_ID=

# Comma-separated notification_type values to NOT forward to Discord.
# Default suppresses idle_prompt (fires every time Claude goes idle - noisy).
# Other known types: permission_prompt, quota_auto_resume_fired,
# quota_auto_resume_stale, quota_auto_resume_disabled, elicitation_dialog,
# elicitation_url_dialog, agent_needs_input, agent_completed
NOTIFY_SKIP_TYPES=idle_prompt
